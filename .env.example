# Metreka frontend environment (copy to .env)
# Current project: wwxhmxrsrqlirjfbmnsk
# Supabase — required (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://wwxhmxrsrqlirjfbmnsk.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_key

# Production app URL (set on Vercel — must match live deployment)
# VITE_APP_URL=https://metreka-zvhr.vercel.app

# Optional: enable Google sign-in button (requires Google provider enabled in Supabase)
# VITE_ENABLE_GOOGLE_AUTH=true

# Optional: external FastAPI backend (leave unset to use synced Supabase data)
# VITE_API_URL=
# VITE_METREKA_API_KEY=

# Demo mode — set to true only for /demo previews with simulated data
# VITE_DEMO_MODE=false

# Optional: Calendly (or other) booking URL for "Book a Demo Call"
# When unset, the CTA routes to /contact?topic=demo instead
# VITE_CALENDLY_URL=https://calendly.com/your-handle/demo

# ---------------------------------------------------------------------------
# Supabase Edge Function secrets (set via Dashboard → Edge Functions → Secrets
# or `supabase secrets set KEY=value`)
# ---------------------------------------------------------------------------
#
# Required for store connections:
#   STORE_CREDENTIALS_KEY   — AES key for encrypting store API tokens
#
# Required for scheduled sync (pg_cron):
#   SYNC_CRON_SECRET        — shared secret; must match value passed to
#                             schedule_store_sync_jobs() in SQL
#
# Shopify OAuth (optional — enables "Connect with Shopify" one-click flow):
#   SHOPIFY_CLIENT_ID
#   SHOPIFY_CLIENT_SECRET
# Create a custom app at https://partners.shopify.com → Apps → Create app
# (or Dev Dashboard → Versions for App URL / redirect URLs)
# App URL: https://metreka-zvhr.vercel.app
# Allowed redirect URL: https://metreka-zvhr.vercel.app/oauth/callback
#                     and http://localhost:8080/oauth/callback
# Then: npx supabase secrets set SHOPIFY_CLIENT_ID=... SHOPIFY_CLIENT_SECRET=... --project-ref wwxhmxrsrqlirjfbmnsk
#
# Without these secrets / OAuth URLs, use Admin API access token connect (manual fields).
#
# Lazada Open Platform (optional OAuth; API-key connect also supported):
#   LAZADA_APP_KEY      — from Lazada Open Platform app console
#   LAZADA_APP_SECRET   — used for OAuth and signed API calls
# Register OAuth redirect: http://localhost:8080/oauth/callback
# Lazada ventures: sg, my, th, vn, ph, id (auto-detected on connect)
#
# Billing (Paddle):
#   PADDLE_API_KEY          — server API key (live or sandbox)
#   PADDLE_WEBHOOK_SECRET   — notification destination secret
#
# Frontend (required for overlay checkout):
#   VITE_PADDLE_CLIENT_TOKEN  — client-side token from Paddle → Developer Tools → Authentication
#   VITE_PADDLE_ENVIRONMENT   — optional: "sandbox" | "production" (auto-detected from token if omitted)
#
# Paddle dashboard checklist:
#   1. Create products/prices matching the pri_* IDs in create-checkout
#   2. Checkout → Checkout settings → set Default payment link (approved domain)
#   3. Notifications → destination:
#      https://wwxhmxrsrqlirjfbmnsk.supabase.co/functions/v1/paddle-webhook
#      Events: subscription.created/updated/activated/canceled/past_due/paused/resumed
#   4. npx supabase secrets set PADDLE_API_KEY=... PADDLE_WEBHOOK_SECRET=... APP_URL=https://metreka-zvhr.vercel.app
#
# Contact form:
#   RESEND_API_KEY          — optional; without it, submissions still save to contact_submissions
#   CONTACT_TO_EMAIL        — optional override (default hello@metreka.com)
#   CONTACT_FROM_EMAIL      — optional Resend from address
#
#   APP_URL                  — production URL for edge functions (https://metreka-zvhr.vercel.app)
#
# Auto-set by Supabase (do not commit):
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY

# ---------------------------------------------------------------------------
# Auth redirect URLs (Supabase Dashboard → Authentication → URL Configuration)
# ---------------------------------------------------------------------------
# Site URL: https://metreka-zvhr.vercel.app
# - http://localhost:8080/auth/callback
# - https://metreka-zvhr.vercel.app/auth/callback
# - http://localhost:8080/oauth/callback
# - https://metreka-zvhr.vercel.app/oauth/callback
# (add your custom domain callbacks here too)
#
# Shopify Dev Dashboard → Versions → App URL / Allowed redirection URL(s):
# - App URL: https://metreka-zvhr.vercel.app
# - Redirect: https://metreka-zvhr.vercel.app/oauth/callback
#   (or use Admin API access token connect if OAuth app URLs are unavailable)

# Google OAuth (Supabase Dashboard → Authentication → Providers → Google)
# Also create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI for Google: https://YOUR_PROJECT.supabase.co/auth/v1/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

