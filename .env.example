# Metreka frontend environment (copy to .env)
# Current project: wwxhmxrsrqlirjfbmnsk
# Supabase — required (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://wwxhmxrsrqlirjfbmnsk.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_key

# Optional: external FastAPI backend (leave unset to use synced Supabase data)
# VITE_API_URL=
# VITE_METREKA_API_KEY=

# Demo mode — set to true only for /demo previews with simulated data
# VITE_DEMO_MODE=false

# ---------------------------------------------------------------------------
# Supabase Edge Function secrets (set via Dashboard → Edge Functions → Secrets
# or `supabase secrets set KEY=value`)
# ---------------------------------------------------------------------------
#
# Required for store connections:
#   STORE_CREDENTIALS_KEY   — AES key for encrypting store API tokens
#
# Required for scheduled sync (pg_cron):
#   SYNC_CRON_SECRET        — shared secret; must match value passed to
#                             schedule_store_sync_jobs() in SQL
#
# Shopify OAuth (optional; API token connect works without these):
#   SHOPIFY_CLIENT_ID
#   SHOPIFY_CLIENT_SECRET
#
# Lazada Open Platform (optional OAuth; API-key connect also supported):
#   LAZADA_APP_KEY      — from Lazada Open Platform app console
#   LAZADA_APP_SECRET   — used for OAuth and signed API calls
# Register OAuth redirect: http://localhost:8080/oauth/callback
# Lazada ventures: sg, my, th, vn, ph, id (auto-detected on connect)
#
# Billing (Paddle):
#   PADDLE_API_KEY
#   PADDLE_WEBHOOK_SECRET
#
# Contact form:
#   RESEND_API_KEY
#
# Auto-set by Supabase (do not commit):
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY

# ---------------------------------------------------------------------------
# Auth redirect URLs (Supabase Dashboard → Authentication → URL Configuration)
# ---------------------------------------------------------------------------
# - http://localhost:8080/auth/callback
# - https://metreka.lovable.app/auth/callback
# - http://localhost:8080/oauth/callback
# - https://metreka.lovable.app/oauth/callback

# Google OAuth (Supabase Dashboard → Authentication → Providers → Google)
# Also create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI for Google: https://YOUR_PROJECT.supabase.co/auth/v1/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

