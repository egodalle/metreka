# GrowthPulse Backend Environment Variables
# Copy this file to .env and fill in your values

# Supabase Configuration
SUPABASE_URL=https://kqymzqqqkzuezgkbhexc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Stripe (for subscription management)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Shopify App Configuration
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_SCOPES=read_orders,read_products,read_customers

# Lazada App Configuration
LAZADA_APP_KEY=your_lazada_app_key
LAZADA_APP_SECRET=your_lazada_app_secret

# Shopee App Configuration
SHOPEE_PARTNER_ID=your_shopee_partner_id
SHOPEE_PARTNER_KEY=your_shopee_partner_key

# Server Configuration
PORT=8000
DEBUG=false
